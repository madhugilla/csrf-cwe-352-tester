{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "CSRFTester": "Debug",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "HttpClient": {
    "TimeoutSeconds": 60,
    "UserAgent": "CSRFTester/1.0",
    "MaxRetries": 3
  },
  "Testing": {
    "DefaultTestTimeoutSeconds": 30,
    "EnableDetailedLogging": false,
    "MaxConcurrentTests": 5
  }
}
